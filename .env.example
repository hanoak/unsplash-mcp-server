# --- Required ---
# Your Unsplash API access key. Register a free app to get one:
#   https://unsplash.com/developers
# The server validates this at startup and exits with a clear message if missing.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# --- Optional ---
# Your registered Unsplash application name. Used as the attribution UTM source
# (utm_source) so photographer/Unsplash links credit the correct app.
# UNSPLASH_APP_NAME=your-registered-app-name

# Log verbosity written to stderr: debug | info | warn | error (default: info).
# LOG_LEVEL=info

# --- Optional: only needed to run `login` (unlocks the 8 write/me tools) ---
# Your Unsplash app's secret key. Find it alongside the access key at
# https://unsplash.com/oauth/applications
# UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here

# Override the default OAuth redirect URI (http://localhost:8734/callback).
# Must match a redirect URI registered on your Unsplash app.
# UNSPLASH_OAUTH_REDIRECT_URI=http://localhost:8734/callback
